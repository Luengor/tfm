{
  "storage": [
    {"type": "sqlite", "params": {"db_path": "exp/.common_db/{run_id}.sqlite"}}
  ],
  "segmenter": [
    {"type": "identity", "params": {}}
  ],
  "embedding": [
    {"type": "mobilenet_v3", "params": {}}
  ],
  "reduction": [
    {"type": "umap", "params": {"n_components": 10, "n_neighbors": 15, "min_dist": 0.0, "metric": "cosine"}}
  ],
  "clustering": [
    {"type": "hdbscan", "params": {"min_cluster_size": 5}},
    {"type": "kmeans", "params": {"n_clusters": 10}},
    {"type": "dbscan", "params": {"min_samples": 5}},
    {"type": "optics", "params": {"min_samples": 5}},
    {"type": "agglomerative", "params": {"n_clusters": 10, "linkage": "average"}}
  ],
  "similarity_search": {"enabled": true, "top_k": 5, "sample_n": null, "sample_seed": 42},
  "repeats": 5,
  "limit": [250, 500, 1000, 2000, 3500, 6416]
}
