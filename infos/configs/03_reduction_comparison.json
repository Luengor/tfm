{
  "limit": 1000,
  "storage": [
    {"type": "sqlite", "params": {}}
  ],
  "segmenter": [
    {"type": "identity", "params": {}}
  ],
  "embedding": [
    {"type": "dinov2_graffiti_style_head", "params": {}}
  ],
  "clustering": [
    {"type": "hdbscan", "params": {"min_cluster_size": 5}}
  ],
  "reduction": [
    {"type": "identity", "params": {}},
    {"type": "pca", "params": {"n_components": 10}},
    {"type": "pca", "params": {"n_components": 50}},
    {"type": "umap", "params": {"n_components": 10, "n_neighbors": 15, "min_dist": 0.0, "metric": "cosine"}},
    {"type": "umap", "params": {"n_components": 10, "n_neighbors": 15, "min_dist": 0.0, "metric": "euclidean"}},
    {"type": "umap", "params": {"n_components": 50, "n_neighbors": 15, "min_dist": 0.0, "metric": "cosine"}},
    {"type": "isomap", "params": {"n_components": 10, "n_neighbors": 10}},
    {"type": "kernel_pca", "params": {"n_components": 50, "kernel": "rbf"}},
    {"type": "kernel_pca", "params": {"n_components": 50, "kernel": "cosine"}},
    {"type": "kernel_pca", "params": {"n_components": 50, "kernel": "linear"}},
    {"type": "kernel_pca", "params": {"n_components": 50, "kernel": "poly"}}
  ]
}
