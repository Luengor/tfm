{
  "runs": [
    {
      "name": "segmenter_yolo11m_finetuned_forgiving-l6416",
      "limit": 6416,
      "storage": {
        "type": "sqlite",
        "params": {
          "db_path": "exp/.common_db/v2_seg_yolo11m_ft_forgiving_l6416.sqlite"
        }
      },
      "segmenter": {
        "type": "yolo",
        "params": {
          "model_path": "models/yolo11m-train-10.pt",
          "threshold": 0.25,
          "merge_threshold": 0.55,
          "padding": 0.15,
          "max_boxes_per_image": 3
        }
      },
      "embedding": {
        "type": "dinov2_graffiti_style_head",
        "params": {}
      },
      "reduction": {
        "type": "umap",
        "params": {
          "n_components": 10,
          "n_neighbors": 15,
          "min_dist": 0.0,
          "metric": "cosine"
        }
      },
      "clustering": {
        "type": "hdbscan",
        "params": {
          "min_cluster_size": 5
        }
      },
      "clear_storage": true,
      "repeats": 3
    }
  ]
}
