{
  "limit": [10, 50, 100, 200, 500, 1000],
  "clustering": [
    {
      "type": "dbscan",
      "params": {}
    },
    {
      "type": "kmeans",
      "params": {"n_clusters": 5}
    },
    {
      "type": "agglomerative",
      "params": {"n_clusters": 5}
    },
    {
      "type": "spectral",
      "params": {"n_clusters": 5}
    },
    {
      "type": "gmm",
      "params": {"n_clusters": 5}
    },
    {
      "type": "affinity_propagation",
      "params": {}
    }
  ],
  "storage": [
    {
      "type": "sqlite",
      "params": {
        "db_path": "benchmark_{run_id}.db"
      }
    }
  ],
  "embedding": [
    {
      "type": "resnet50",
      "params": {}
    }
  ],
  "reduction": [
    {
      "type": "identity",
      "params": {}
    },
    {
      "type": "pca",
      "params": {
        "n_components": 50
      }
    },
    {
      "type": "umap",
      "params": {
        "n_components": 2
      }
    }
  ],
  "clear_storage": [true]
}
