	year = {2000},
	pages = {2319--2323},
	file = {PDF:/home/tino/Zotero/storage/55Q8D88U/Tenenbaum et al. - 2000 - A Global Geometric Framework for Nonlinear Dimensionality Reduction.pdf:application/pdf},
}

