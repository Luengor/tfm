
@misc{schroff_facenet_2015,
	title = {{FaceNet}: {A} {Unified} {Embedding} for {Face} {Recognition} and {Clustering}},
	shorttitle = {{FaceNet}},
	url = {https://arxiv.org/abs/1503.03832v3},
	doi = {10.1109/CVPR.2015.7298682},
	abstract = {Despite significant recent advances in the field of face recognition, implementing face verification and recognition efficiently at scale presents serious challenges to current approaches. In this paper we present a system, called FaceNet, that directly learns a mapping from face images to a compact Euclidean space where distances directly correspond to a measure of face similarity. Once this space has been produced, tasks such as face recognition, verification and clustering can be easily implemented using standard techniques with FaceNet embeddings as feature vectors. Our method uses a deep convolutional network trained to directly optimize the embedding itself, rather than an intermediate bottleneck layer as in previous deep learning approaches. To train, we use triplets of roughly aligned matching / non-matching face patches generated using a novel online triplet mining method. The benefit of our approach is much greater representational efficiency: we achieve state-of-the-art face recognition performance using only 128-bytes per face. On the widely used Labeled Faces in the Wild (LFW) dataset, our system achieves a new record accuracy of 99.63\%. On YouTube Faces DB it achieves 95.12\%. Our system cuts the error rate in comparison to the best published result by 30\% on both datasets. We also introduce the concept of harmonic embeddings, and a harmonic triplet loss, which describe different versions of face embeddings (produced by different networks) that are compatible to each other and allow for direct comparison between each other.},
	language = {en},
	urldate = {2026-04-21},
	journal = {arXiv.org},
	author = {Schroff, Florian and Kalenichenko, Dmitry and Philbin, James},
	month = mar,
	year = {2015},
	doi = {10.1109/CVPR.2015.7298682},
	file = {Full Text PDF:/home/tino/Zotero/storage/BST4Z9NK/Schroff et al. - 2015 - FaceNet A Unified Embedding for Face Recognition and Clustering.pdf:application/pdf},
}

@article{fogaca_deep_2023,
	title = {Deep {Learning}-{Based} {Graffiti} {Detection}: {A} {Study} {Using} {Images} from the {Streets} of {Lisbon}},
	volume = {13},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	issn = {2076-3417},
	shorttitle = {Deep {Learning}-{Based} {Graffiti} {Detection}},
	url = {https://www.mdpi.com/2076-3417/13/4/2249},
	doi = {10.3390/app13042249},
	abstract = {This research work comes from a real problem from Lisbon City Council that was interested in developing a system that automatically detects in real-time illegal graffiti present throughout the city of Lisbon by using cars equipped with cameras. This system would allow a more efficient and faster identification and clean-up of the illegal graffiti constantly being produced, with a georeferenced position. We contribute also a city graffiti database to share among the scientific community. Images were provided and collected from different sources that included illegal graffiti, images with graffiti considered street art, and images without graffiti. A pipeline was then developed that, first, classifies the image with one of the following labels: illegal graffiti, street art, or no graffiti. Then, if it is illegal graffiti, another model was trained to detect the coordinates of graffiti on an image. Pre-processing, data augmentation, and transfer learning techniques were used to train the models. Regarding the classification model, an overall accuracy of 81.4\% and F1-scores of 86\%, 81\%, and 66\% were obtained for the classes of street art, illegal graffiti, and image without graffiti, respectively. As for the graffiti detection model, an Intersection over Union (IoU) of 70.3\% was obtained for the test set.},
	language = {en},
	number = {4},
	urldate = {2026-04-24},
	journal = {Applied Sciences},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Fogaça, Joana and Brandão, Tomás and Ferreira, João C.},
	month = jan,
	year = {2023},
	keywords = {computer vision, graffiti, classification, detection, street art},
	pages = {2249},
	file = {Full Text PDF:/home/tino/Zotero/storage/FVTSC82L/Fogaça et al. - 2023 - Deep Learning-Based Graffiti Detection A Study Using Images from the Streets of Lisbon.pdf:application/pdf},
}

