	note = {arXiv:2304.07193 [cs.CV]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition},
	file = {Preprint PDF:/home/tino/Zotero/storage/M99USEW3/Oquab et al. - 2024 - DINOv2 Learning Robust Visual Features without Supervision.pdf:application/pdf;Snapshot:/home/tino/Zotero/storage/6KALNRN4/2304.html:text/html},
